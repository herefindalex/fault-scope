{
  "name": "faultscope-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app components content e2e i18n src/case.ts src/case.test.ts src/language-choice.ts src/snippets.ts src/case-data.json mdx-components.tsx next.config.mjs playwright.config.ts vitest.config.ts package.json tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.5",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
